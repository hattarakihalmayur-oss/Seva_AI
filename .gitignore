# ──────────────────────────────────────────────────────────────────────────────
# BharatSeva AI — Root .gitignore
# Protects all secrets and build artifacts from being committed.
# ──────────────────────────────────────────────────────────────────────────────

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment files (NEVER commit these) ────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging
# Allow the example template
!.env.example

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
.vite/

# ── IDE & Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Docker ────────────────────────────────────────────────────────────────────
# Allow docker-compose files (they contain no secrets; secrets come from .env)
!docker-compose.yml
!docker-compose.prod.yml

# ── Coverage ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ==============================================================================
# BharatSeva AI - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example: mongodb://localhost:27017/bharatseva
# Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/bharatseva?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bharatseva

# Authentication & JWT Configuration
# Generate a cryptographically strong secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Sarvam AI API Configuration (Kept strictly on the backend)
# Obtain an API key from https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Application URLs & CORS Configuration (Essential for Render deployment)
# In Render Web Service, RENDER_EXTERNAL_URL is set automatically, or set BACKEND_URL explicitly:
# BACKEND_URL=https://seva-ai-backend.onrender.com
BACKEND_URL=http://localhost:5000

# Frontend application URL (for CORS and DigiLocker redirects):
# FRONTEND_URL=https://seva-ai-frontend.onrender.com
FRONTEND_URL=http://localhost:3000

# Comma-separated list of additional allowed CORS origins (Render domains are auto-allowed)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# DigiLocker / MeriPehchaan OAuth 2.0 Configuration
# Register your app at API Setu (https://apisetu.gov.in) or DigiLocker Partners (https://partners.digitallocker.gov.in)
DIGILOCKER_CLIENT_ID=your_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/digilocker/callback
DIGILOCKER_AUTH_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/token
DIGILOCKER_API_BASE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1
DIGILOCKER_ENV=sandbox


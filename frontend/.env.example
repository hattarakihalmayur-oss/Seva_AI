# ==============================================================================
# BharatSeva AI - Frontend Environment Configuration Template
# ==============================================================================
# NOTE: All variables prefixed with VITE_ are embedded into the client bundle at
# build time and are exposed publicly in the browser.
# NEVER place secrets, API keys (e.g. Sarvam API Key), database URLs, or private tokens here.
# ==============================================================================

# Backend API Base URL (must point to your backend API server)
# In local development: http://localhost:5000/api
# In Render (Static Site or Web Service):
# VITE_API_BASE_URL=https://seva-ai-backend.onrender.com/api
# (Note: VITE_API_URL and VITE_BACKEND_URL are also accepted, and /api will be appended automatically if omitted)
VITE_API_BASE_URL=http://localhost:5000/api

# Application metadata
VITE_APP_NAME=BharatSeva AI
VITE_APP_VERSION=1.0.0

